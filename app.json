{
  "expo": {
    "name": "wise-pay",
    "slug": "wise-pay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/png/icon.png",
    "scheme": "wisepay",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wisepay"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/png/android-icon-foreground.png",
        "backgroundImage": "./assets/images/png/android-icon-background.png",
        "monochromeImage": "./assets/images/png/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.wisepay"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/png/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/png/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-build-properties",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0869c06-d368-4c7f-b04d-c3439c01ae57"
      }
    }
  }
}
